<!-- Extra games for the XM Solitaire PWA, written in the XM Solitaire rules format
     (see Mods_Rules.html in the XM Solitaire help). A game here with the same name as one
     in standard.xml replaces it. -->
<xmsol>

<game name="Spider" decks="2">
<foundation x="240" repeat="8">k all down</foundation>
<tableau repeat="10" count="54" hide="-1">group<out>suit</out></tableau>
<stock deal="10"/>
</game>

<game name="Spider One Suit" decks="8" suit="s">
<foundation x="240" repeat="8">k all down</foundation>
<tableau repeat="10" count="54" hide="-1">group<out>suit</out></tableau>
<stock deal="10"/>
</game>

<game name="Spiderette">
<foundation x="250" repeat="4">k all down</foundation>
<tableau repeat="7" shape="incr" count="28" hide="-1">group<out>suit</out></tableau>
<stock deal="7"/>
</game>

<!-- Same as XM's Golf, but the waste pile starts with a random card instead of an ace. -->
<game name="Golf" autoplay="0">
<tableau repeat="7" count="35">no noseq</tableau>
<foundation x="167" y="850" count="1" dir="right" spacing="60">anyrank updown anysuit</foundation>
<stock y="850"><out>foundation</out></stock>
</game>

<game name="Beleaguered Castle">
<foundation repeat="4" x="590" count="4">a</foundation>
<tableau repeat="8" count="48">down</tableau>
</game>

<game name="Streets and Alleys">
<foundation repeat="4" x="590"/>
<tableau repeat="8" count="52">down</tableau>
</game>

<!-- 28 cards in three overlapping peaks. A card can be played when nothing overlaps it. -->
